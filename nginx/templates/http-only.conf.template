# Plain-HTTP fallback rendered by select-config.sh (the nginx service's
# command) whenever no TLS cert exists yet for ${DOMAIN} — the case for
# local `make prod` simulation (DOMAIN defaults to localhost, which Let's
# Encrypt can never issue a cert for) and for a fresh real deploy before
# the certbot-init step has run once. The acme-challenge location stays
# live here too, so a real deploy can run certbot's webroot challenge over
# this same port before a cert exists.
upstream backend {
    server backend:8000;
}

upstream frontend {
    server frontend:3000;
}

server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # API — proxy to FastAPI (Upgrade/Connection headers needed for the
    # /api/v1/ws/prices WebSocket route, not just plain HTTP calls)
    location /api/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        client_max_body_size 10m;
    }

    # FastAPI interactive docs
    location ~ ^/(docs|redoc|openapi.json) {
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    # Frontend — proxy to Next.js
    location / {
        proxy_pass http://frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

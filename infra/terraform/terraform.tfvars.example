# Copy to terraform.tfvars and fill in — never commit terraform.tfvars itself
# (it's gitignored, but double-check `git status` before committing anyway).

do_token          = "dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
dns_zone          = "example.com"       # must already be added under DO → Networking → Domains
app_hostname      = "@"                 # "@" = apex domain, or e.g. "app" for app.example.com
letsencrypt_email = "you@example.com"

ssh_public_key_path = "~/.ssh/id_rsa.pub"

# Optional overrides (defaults shown)
# droplet_region = "blr1"
# droplet_size   = "s-2vcpu-4gb"
# repo_url       = "https://github.com/manju2606/MTS-Dev.git"
# repo_branch    = "main"

# Leave blank to skip AI Analysis/signal features for now
anthropic_api_key = ""
